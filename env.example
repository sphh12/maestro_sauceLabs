# env.example — 앱 비종속 변수 (stage 3 파라미터화 대비 문서)
# 사용법: maestro test -e APP_ID=... -e USERNAME=... .maestro/smoke/login.yaml
# (실제 .env 는 커밋 금지, env.example 만 추적)
# ──────────────────────────────────────────────────────────────

# 대상 앱 (Android 패키지 = appId). flow 헤더에서 ${APP_ID} 로 참조.
APP_ID=com.saucelabs.mydemoapp.android

# 로그인 자격증명 (SauceLabs *모바일* My Demo App 공개 데모 값)
#   주의: 'standard_user / secret_sauce' 는 웹(saucedemo.com) 값이며 이 모바일 앱엔 안 통함.
#   Android 정상 계정 이메일은 앱 자체 오타로 'bod' (bob 아님). 전 계정 공통 비번 10203040.
USERNAME=bod@example.com
PASSWORD=10203040

# 잠긴 계정 (네거티브/regression 테스트용) — 'locked out' 에러 발생
LOCKED_USERNAME=alice@example.com

# 체크아웃 배송 주소 (추후 e2e/checkout.yaml 용)
SHIP_FULL_NAME=John Doe
SHIP_ADDRESS1=123 Main St
SHIP_CITY=Seoul
SHIP_ZIP=12345
SHIP_COUNTRY=South Korea

# 결제 카드 (더미 — 실제 결제 없음)
CARD_NAME=John Doe
CARD_NUMBER=4111111111111111
CARD_EXPIRY=0826
CARD_CVV=123
